verify_deployment.py

# --- Environment variables (NEVER commit real .env files) ---
.env
.env.*
!.env.example
frontend/.env
frontend/.env.*
!frontend/.env.example

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
.Python
.venv/
venv/
ENV/
env/
*.egg-info/
dist/
build/
*.egg
pip-log.txt
pip-delete-this-directory.txt

# --- Audio cache (generated files, not source) ---
audio_cache/
backend/audio_cache/

# --- Node / Vite ---
node_modules/
frontend/node_modules/
frontend/dist/
.npm
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# --- IDE / Editor ---
.vscode/
.idea/
*.swp
*.swo
*.suo
.project
.classpath

# --- OS ---
.DS_Store
Thumbs.db
desktop.ini

