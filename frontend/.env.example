# ==========================================
# AI VOICE INDIA — Frontend Environment
# ==========================================
# Copy this file to .env and fill in values for local/production builds.
# NEVER commit .env to Git.

# --- Backend API URL ---
# For LOCAL development: leave empty (Vite dev-server proxy at /api handles it).
# For PRODUCTION (Render): set to your deployed backend URL WITHOUT trailing slash.
# Example: https://ai-voice-india-backend.onrender.com
VITE_API_URL=

# --- Local dev proxy target (optional, defaults to http://127.0.0.1:8000) ---
# Only needed if your local backend runs on a different port.
VITE_DEV_BACKEND=http://127.0.0.1:8000

# --- Firebase Google Authentication ---
# Create a Firebase project at https://console.firebase.google.com
# Enable Google Sign-In: Authentication → Sign-in method → Google → Enable
# Get these values from: Project Settings → Your apps → Web app config
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_APP_ID=your_firebase_app_id_here
# Optional (only needed if you use Firebase Storage / Analytics):
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id_here

