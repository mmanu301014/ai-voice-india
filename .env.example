# ==========================================
# AI VOICE INDIA — Backend Environment
# ==========================================
# Copy this file to .env and fill in values.
# NEVER commit .env to Git.

# --- Server ---
PORT=8000
HOST=0.0.0.0
ENV=development

# --- CORS: comma-separated list of allowed frontend origins ---
# Leave as * for open development. Set to your Render frontend URL in production.
# Example: https://ai-voice-india-frontend.onrender.com
CORS_ORIGINS=*

# --- Authentication (REQUIRED) ---
# Generate a strong secret: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=your-strong-random-secret-here
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# --- Razorpay Payment Gateway (Test Mode / Live Mode) ---
# Get your keys from: https://dashboard.razorpay.com/app/keys
# In Test Mode, use Key ID starting with "rzp_test_..."
# Key Secret MUST NEVER be committed to Git or sent to the frontend browser.
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_secret_here
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here

# --- Optional Future Cloud Providers ---
# Leave empty for zero-cost ₹0 free mode (Edge TTS + gTTS are used by default).
GOOGLE_APPLICATION_CREDENTIALS=
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
ELEVENLABS_API_KEY=
SARVAM_API_KEY=
