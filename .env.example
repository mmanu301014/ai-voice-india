# ==========================================
# AI VOICE INDIA — Backend Environment
# ==========================================
# Copy this file to .env and fill in values.
# NEVER commit .env to Git.

# --- Server ---
PORT=8000
HOST=0.0.0.0
ENV=development

# --- CORS: comma-separated list of allowed frontend origins ---
# Leave as * for open development. Set to your Render frontend URL in production.
# Example: https://ai-voice-india-frontend.onrender.com
CORS_ORIGINS=*

# --- Optional Future Cloud Providers ---
# Leave empty for zero-cost ₹0 free mode (Edge TTS + gTTS are used by default).
GOOGLE_APPLICATION_CREDENTIALS=
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
ELEVENLABS_API_KEY=
SARVAM_API_KEY=
